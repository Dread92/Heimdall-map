# runtime data and local state — never goes into the image
*.sqlite
*.sqlite-wal
*.sqlite-shm
__pycache__/
*.pyc
.venv/
config.json
.flyapp
*.log

# repo furniture the service does not need at runtime
.git/
.github/
.vscode/
docs/
tests/
scripts/
*.bat
*.md
!README.md

# the satellite layer lives on the volume, not in the image
imagery/
last-exit.json
