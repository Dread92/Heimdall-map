# runtime data and local state — never goes into the image (1.58.46, the audit (I7): at any depth, and every secret file)
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/__pycache__/
**/*.pyc
vapid.json
.env
.env.*
*.pem
*.session
*.jks
*.keystore
*.mbtiles
diag/
.venv/
config.json
.flyapp
*.log

# repo furniture the service does not need at runtime
.git/
.github/
.vscode/
docs/
tests/
scripts/
*.bat
*.md
!README.md

# the satellite layer lives on the volume, not in the image
imagery/
last-exit.json
